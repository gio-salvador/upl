#!/usr/bin/env bash
# Shared gitops hook (both tiers): enforce Conventional Commits.
# Attached via core.hooksPath by claude/gitops/setup-gitops.sh.
set -euo pipefail

msg_file="$1"
header="$(head -n1 "$msg_file")"

# Allow merge/revert/fixup/squash autosquash commits through unchanged.
case "$header" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# type(optional-scope)(optional !): subject
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?(!)?: .+'

if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
commit-msg: not a Conventional Commit.
  got:    $header
  expect: <type>[(scope)][!]: <subject>
  types:  feat fix docs style refactor perf test build ci chore revert
EOF
  exit 1
fi
exit 0
