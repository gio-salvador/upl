#!/usr/bin/env bash
# sc-secret — the single entry point for reading and writing secrets, so no tool ever
# touches a secret store directly (plan §2/§5.1). bash 3.2-safe (no mapfile/assoc-arrays).
#
# Resolution order for `get` (most specific wins):
#   1. process env var   SC_<SCOPE>_<NAME>  (CI / one-off injection)
#   2. project secret    <repo>/.claude/secrets.local.yaml   (gitignored; `name: value`)
#   3. global file       ~/.claude/secrets/<scope>/<name>     (0600, gitignored)
#   4. macOS Keychain    service `sc.<scope>.<name>`, account $USER  (registry backend: keychain)
#
# The versioned registry ~/.claude/config/secrets-registry.yaml lists names + backend only,
# never values. `set` honours the registry backend (default: file).
#
# Usage:
#   sc-secret get   <scope>/<name>        # print value to stdout (only)
#   sc-secret set   <scope>/<name> [val]  # value from arg or, preferably, stdin
#   sc-secret where <scope>/<name>        # which layer would answer (no value printed)
#   sc-secret list                        # registry names
#   sc-secret check [--root DIR]          # secret-placement check; non-zero on violation
set -uo pipefail

CONFIG_HOME="${CLAUDE_CONFIG_HOME:-$HOME/.claude}"
REGISTRY="$CONFIG_HOME/config/secrets-registry.yaml"
STORE="$CONFIG_HOME/secrets"

die() { echo "sc-secret: $*" >&2; exit 2; }
usage() { sed -n '14,21p' "$0"; exit 2; }

# Split "<scope>/<name>" → sets g_scope, g_name.
split_id() {
  case "$1" in
    */*) g_scope="${1%%/*}"; g_name="${1#*/}" ;;
    *) die "id must be <scope>/<name> (got '$1')" ;;
  esac
  [ -n "$g_scope" ] && [ -n "$g_name" ] || die "id must be <scope>/<name> (got '$1')"
}

env_var_name() { # <scope>/<name> → SC_<SCOPE>_<NAME>
  printf 'SC_%s_%s' "$g_scope" "$g_name" | tr '[:lower:]-' '[:upper:]_' | tr -cd 'A-Z0-9_'
}

# Backend for an id from the registry (default: file). Pure grep/awk, no YAML lib.
registry_backend() {
  [ -r "$REGISTRY" ] || { echo file; return; }
  awk -v want="$g_scope/$g_name" '
    /^[[:space:]]*-[[:space:]]*name:/ { n=$0; sub(/^.*name:[[:space:]]*/,"",n); gsub(/["'"'"']/,"",n); cur=(n==want) }
    cur && /^[[:space:]]*backend:/ { b=$0; sub(/^.*backend:[[:space:]]*/,"",b); gsub(/["'"'"']/,"",b); print b; exit }
  ' "$REGISTRY" | head -1 | grep -E '^(file|keychain)$' || echo file
}

registry_has() {
  [ -r "$REGISTRY" ] && grep -Eq "name:[[:space:]]*[\"']?$g_scope/$g_name([\"'[:space:]]|$)" "$REGISTRY"
}
registry_add() { # append a name-only entry if absent
  registry_has && return 0
  [ -f "$REGISTRY" ] || { mkdir -p "$(dirname "$REGISTRY")"; printf 'secrets:\n' > "$REGISTRY"; }
  {
    printf '  - name: %s\n' "$g_scope/$g_name"
    printf '    scope: %s\n' "$g_scope"
    printf '    backend: %s\n' "${1:-file}"
    printf '    rotation: on-exposure\n'
  } >> "$REGISTRY"
}

project_secret_file() {
  local r; r="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$r" ] && printf '%s/.claude/secrets.local.yaml' "$r"
}
read_project_secret() { # echoes value if present in the project secrets file
  local f; f="$(project_secret_file)"; [ -n "$f" ] && [ -r "$f" ] || return 1
  awk -v k="$g_name" '
    { line=$0; sub(/^[[:space:]]+/,"",line)
      if (line ~ "^"k"[[:space:]]*:") { v=line; sub(/^[^:]*:[[:space:]]*/,"",v); gsub(/^["'"'"']|["'"'"']$/,"",v); print v; found=1; exit } }
    END { exit(found?0:1) }' "$f"
}

cmd_where() {
  split_id "$1"
  local ev; ev="$(env_var_name)"
  if [ -n "${!ev:-}" ]; then echo "env:$ev"; return 0; fi
  if read_project_secret >/dev/null 2>&1; then echo "project:$(project_secret_file)"; return 0; fi
  if [ -r "$STORE/$g_scope/$g_name" ]; then echo "global:$STORE/$g_scope/$g_name"; return 0; fi
  if [ "$(registry_backend)" = keychain ] && security find-generic-password -s "sc.$g_scope.$g_name" -a "$USER" >/dev/null 2>&1; then
    echo "keychain:sc.$g_scope.$g_name"; return 0
  fi
  echo "MISSING"; return 1
}

cmd_get() {
  split_id "$1"
  local ev; ev="$(env_var_name)"
  if [ -n "${!ev:-}" ]; then printf '%s' "${!ev}"; return 0; fi
  local v; if v="$(read_project_secret 2>/dev/null)" && [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  if [ -r "$STORE/$g_scope/$g_name" ]; then cat "$STORE/$g_scope/$g_name"; return 0; fi
  if [ "$(registry_backend)" = keychain ]; then
    security find-generic-password -s "sc.$g_scope.$g_name" -a "$USER" -w 2>/dev/null && return 0
  fi
  echo "sc-secret: '$1' not found in any layer. Set it with: sc-secret set $1" >&2
  return 1
}

cmd_set() {
  local id="$1"                       # keep the id; never echo the value
  split_id "$1"; shift
  local val
  if [ $# -gt 0 ]; then val="$1"; else
    [ -t 0 ] && echo "sc-secret: reading value from stdin (Ctrl-D to end)…" >&2
    val="$(cat)"
  fi
  [ -n "$val" ] || die "refusing to set an empty value"
  local backend; backend="$(registry_backend)"
  if [ "$backend" = keychain ]; then
    security add-generic-password -U -s "sc.$g_scope.$g_name" -a "$USER" -w "$val" || die "keychain write failed"
    echo "sc-secret: set $id (keychain)" >&2
  else
    umask 077; mkdir -p "$STORE/$g_scope"; printf '%s' "$val" > "$STORE/$g_scope/$g_name"; chmod 600 "$STORE/$g_scope/$g_name"
    echo "sc-secret: set $id (file $STORE/$g_scope/$g_name, 0600)" >&2
  fi
  registry_add "$backend"
}

cmd_list() {
  [ -r "$REGISTRY" ] || { echo "(no registry at $REGISTRY)"; return 0; }
  grep -E '^[[:space:]]*-[[:space:]]*name:' "$REGISTRY" | sed -E 's/^[^:]*:[[:space:]]*//; s/["'"'"']//g'
}

cmd_check() {
  local root=""; [ "${1:-}" = "--root" ] && root="${2:-}"
  [ -n "$root" ] || root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  local bad=0
  # Global store must not be group/world-accessible.
  if [ -d "$STORE" ]; then
    # -L on both: the documented layout reaches the store through a symlink (~/.claude/secrets
    # into the dotfiles repository), and without it this read the LINK's mode, 755 on macOS and
    # 777 on Linux, so a correctly locked store failed on every machine that follows the layout.
    # GNU FIRST, AND THE ORDER IS LOAD-BEARING. To GNU stat, -f means --file-system, so the BSD
    # form fails on '%Lp' as a filename yet still prints file-system status for the real operand
    # to stdout before exiting non-zero; the fallback's mode was then appended to that output and
    # the check refused every store on Linux. BSD stat rejects -c on stderr alone, so running the
    # GNU form first leaves nothing behind on either platform.
    local perm; perm="$(stat -L -c '%a' "$STORE" 2>/dev/null || stat -L -f '%Lp' "$STORE" 2>/dev/null || echo '')"
    case "$perm" in ""|700|750|500) ;; *) echo "sc-secret check: $STORE perms $perm too open (want 700)" >&2; bad=1 ;; esac
  fi
  # No tracked secret-shaped files / shell-secrets in the repo (delegate to the linter).
  if [ -n "$root" ]; then
    local lint="$CONFIG_HOME/gitops/lib/check-hardcoding.sh"
    if [ -x "$lint" ] || [ -r "$lint" ]; then
      bash "$lint" --root "$root" --quiet 2>/dev/null || { echo "sc-secret check: placement findings in $root (run check-hardcoding.sh for detail)" >&2; bad=1; }
    fi
  fi
  [ "$bad" -eq 0 ] && { echo "sc-secret check: clean"; return 0; }
  return 1
}

case "${1:-}" in
  get)   shift; [ $# -ge 1 ] || usage; cmd_get "$1" ;;
  set)   shift; [ $# -ge 1 ] || usage; cmd_set "$@" ;;
  where) shift; [ $# -ge 1 ] || usage; cmd_where "$1" ;;
  list)  cmd_list ;;
  check) shift; cmd_check "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command '$1' (get|set|where|list|check)" ;;
esac
