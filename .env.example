# Template for the git-ignored .env at the repository root. You do not fill this in by hand:
# scripts/bootstrap-cloudflare.sh writes it from a root Cloudflare token, and scripts/iac.sh
# reads it. Never commit real values. Nothing else belongs in this file.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TOFU_STATE_BUCKET=
TOFU_STATE_ACCESS_KEY_ID=
TOFU_STATE_SECRET_ACCESS_KEY=
TOFU_STATE_ENDPOINT=
PAGES_PROJECT_NAME=unified-path-of-light

# Empty means the pages.dev address. Set to https://<domain> only after the certificate is
# active (docs/runbook-go-live.md, step 8).
SITE=
# Empty means no custom domain and no DNS records. Set to the apex, for example
# unifiedpathoflight.com, to attach it.
SITE_DOMAIN=
