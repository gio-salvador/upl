# Copy to terraform.tfvars (git-ignored) for a local run. Never commit real values.
# The API token is NOT set here: pass it as TF_VAR_cloudflare_api_token in the environment.

cloudflare_account_id = ""
pages_project_name    = "unified-path-of-light"
site_origin           = ""

# The custom domain. Leave site_domain empty until the zone is in this account; leave
# site_origin empty until the certificate is active (see docs/runbook-go-live.md).
site_domain     = ""
enable_dnssec   = false
lock_down_email = false
