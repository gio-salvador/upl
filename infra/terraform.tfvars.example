# Copy to terraform.tfvars (git-ignored) for a local run. Never commit real values.
# The API token is NOT set here: pass it as TF_VAR_cloudflare_api_token in the environment.

cloudflare_account_id = ""
pages_project_name    = "unified-path-of-light"
site_origin           = ""

# The custom domain. Leave site_domain empty and nothing below has any effect.
# Set site_origin to https://<site_domain> only after the domain is active (see the runbook).
# For example: site_domain = "unifiedpathoflight.com"
site_domain          = ""
site_domain_www      = true
site_domain_dnssec   = true
site_domain_no_email = true
