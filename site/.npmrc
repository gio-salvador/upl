# Supply-chain cooldown: never resolve a version published less than 7 days ago.
# Honoured by npm 11.10 and later (local installs). The npm 10 bundled with the pinned Node in
# CI ignores it, which is safe: CI runs `npm ci` from the lockfile and resolves nothing, and
# Dependabot applies its own 7-day cooldown.
min-release-age=7
engine-strict=true
save-exact=true
