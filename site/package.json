{
  "name": "upl-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync-paper": "node scripts/sync-paper.mjs",
    "predev": "npm run sync-paper && npm run clean-cache",
    "prebuild": "npm run sync-paper && npm run clean-cache",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:md": "cd .. && markdownlint-cli2 \"**/*.md\"",
