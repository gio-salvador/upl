    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
