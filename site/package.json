{
  "name": "upl-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync-paper": "node scripts/sync-paper.mjs",
    "predev": "npm run sync-paper && node scripts/clear-content-cache.mjs dev",
    "prebuild": "npm run sync-paper && node scripts/clear-content-cache.mjs build",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:md": "cd .. && markdownlint-cli2 \"**/*.md\"",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "playwright": "1.63.0",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
