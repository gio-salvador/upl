---
// The site mark: the same sun as public/favicon.svg, drawn in the current text colour.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg class="sun-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M32 6v12M32 46v12M6 32h12M46 32h12M13.6 13.6l8.5 8.5M41.9 41.9l8.5 8.5M50.4 13.6l-8.5 8.5M22.1 41.9l-8.5 8.5" />
  </g>
  <circle cx="32" cy="32" r="9" fill="currentColor" />
</svg>
