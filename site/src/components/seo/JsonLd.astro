---
// Emits Schema.org JSON-LD blocks. These are data, not executable script, so the
// strict script-src in public/_headers does not apply to them.
// Adapted from salvador-cloud-site (MIT), see THIRD-PARTY-NOTICES.md.
interface Props { data: Record<string, unknown>[] }
const { data } = Astro.props;
// JSON.stringify leaves `<` alone, so a title containing `</script>` would close the block and
// inject markup into the head. Escaping `<` keeps the JSON valid and the block closed.
const encode = (block: Record<string, unknown>) => JSON.stringify(block).replace(/</g, '\\u003c');
---
{data.map((block) => <script is:inline type="application/ld+json" set:html={encode(block)} />)}
