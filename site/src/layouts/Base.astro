---
import '../styles/global.css';
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { allEntries, childrenOf } from '../lib/nav';
import { site } from '../lib/site';
import { breadcrumbListSchema, websiteSchema, type Crumb } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description = site.tagline, crumbs = [], ogType, noindex } = Astro.props;
const siteName = site.name;
const origin = Astro.site!;
const jsonLd = [websiteSchema(origin), ...(crumbs.length ? [breadcrumbListSchema(origin, crumbs)] : [])];
const parts = childrenOf(await allEntries(), 'index');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Meta title={title} description={description} ogType={ogType} noindex={noindex} />
    <JsonLd data={jsonLd} />
  </head>
  <body>
    <header>
      <a class="brand" href="/">{siteName}</a>
      <nav>
        {parts.map((p) => <a href={`/${p.id}/`}>{p.data.title}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>{site.alternateName}: {site.tagline.toLowerCase()}</footer>
  </body>
</html>
