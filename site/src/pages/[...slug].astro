---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allEntries, trail, type Entry } from '../lib/nav';
import { describe } from '../lib/describe';

export async function getStaticPaths() {
  const entries = await allEntries();
  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry, crumbs: trail(entries, entry.id) } }));
}

interface Props { entry: Entry; crumbs: Entry[] }
const { entry, crumbs } = Astro.props;
const { Content } = await render(entry);
const breadcrumbs = [
  { label: 'Home', href: '/' },
  ...[...crumbs, entry].map((e) => ({ label: e.data.title, href: `/${e.id}/` })),
];
---
<Base title={entry.data.title} description={describe(entry.data, entry.body)} crumbs={breadcrumbs} ogType="article">
  <p class="crumbs">
    <a href="/">Home</a>
    {crumbs.map((c) => <span> / <a href={`/${c.id}/`}>{c.data.title}</a></span>)}
  </p>
  <article><Content /></article>
</Base>
