---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { describe } from '../lib/describe';

const entry = await getEntry('teachings', 'index');
if (!entry) throw new Error('content/README.md is missing');
const { Content } = await render(entry);
---
<Base title="Unified Path of Light" description={describe(entry.data, entry.body)}><article><Content /></article></Base>
