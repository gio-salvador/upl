---
import { getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { describe } from '../lib/describe';
import { site } from '../lib/site';
import rays from '../assets/hero-crepuscular-rays.jpg';

const entry = await getEntry('teachings', 'index');
if (!entry) throw new Error('content/README.md is missing');
const { Content } = await render(entry);
---
<Base title="Unified Path of Light" description={describe(entry.data, entry.body)}>
  <div class="hero" slot="hero">
    <Picture
      src={rays}
      formats={['avif', 'webp']}
      widths={[640, 960, 1440, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      alt="Rays of sunlight fanning out from behind clouds above a dark line of pine forest."
    />
    <p class="hero-text"><span class="eyebrow">{site.alternateName}</span>{site.tagline}</p>
  </div>
  <article class="home"><Content /></article>
</Base>
